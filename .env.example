# Example only. Copy to .env and change local secrets before use.
APP_ENV=development
POSTGRES_DB=puppletrouble
POSTGRES_USER=puppletrouble
POSTGRES_PASSWORD=change-local-db-password
DATABASE_URL=postgresql+psycopg://puppletrouble:change-local-db-password@127.0.0.1:5432/puppletrouble
JWT_SECRET=replace-with-a-random-local-secret
MODEL_API_KEY=
MODEL_API_BASE_URL=
MODEL_NAME=
AI_MODE=mock
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10
MAX_IMAGE_PIXELS=25000000
ALLOW_DEV_HTTP=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
